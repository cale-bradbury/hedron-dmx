{
  "name": "hedron-dmx-lighting",
  "displayName": "DMX Lighting",
  "version": "0.1.0",
  "private": true,
  "description": "Drive DMX lighting fixtures from Hedron sketches over USB, ArtNet and sACN.",
  "author": "Cale Bradbury",
  "license": "ISC",
  "type": "module",
  "hedron": {
    "id": "dmx-lighting",
    "apiVersion": 1,
    "renderer": "src/index.ts",
    "main": "src/main.ts",
    "mainExternals": [
      "usb"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier . --write",
    "verify": "tsup && node scripts/verify-rig.mjs"
  },
  "dependencies": {
    "usb": "^2.17.0"
  },
  "devDependencies": {
    "@hedron-gl/engine": "link:../hedron/packages/engine",
    "@hedron-gl/plugin-sdk": "link:../hedron/packages/plugin-sdk",
    "@hedron-gl/ui-core": "link:../hedron/packages/ui-core",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.18",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "tsup": "^8.3.6",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.0.0"
}
